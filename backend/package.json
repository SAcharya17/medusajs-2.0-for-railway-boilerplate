{
  "name": "medusa-2.0-boilerplate-backend",
  "version": "0.0.2",
  "description": "A Prebaked Medusa 2.0 backend",
  "author": "Rasmus Puls",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node src/scripts/postBuild.js",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "ib": "init-backend",
    "start": "init-backend && cd .medusa/server && medusa start --verbose",
    "dev": "medusa develop",
    "email:dev": "email dev --dir=./src/modules/email-notifications/templates --port=3002",
    "predeploy": "medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/notification-sendgrid": "2.19.0",
    "@medusajs/payment-stripe": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@medusajs/workflow-engine-redis": "2.19.0",
    "@react-email/components": "^1.0.1",
    "@rokmohar/medusa-plugin-meilisearch": "2.0.0",
    "medusajs-launch-utils": "0.0.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "6.25.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@react-email/preview-server": "^5.1.0",
    "@swc/core": "1.16.1",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react-email": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "csv-parse": "^7.0.2",
    "ajv": "^8.18.0",
    "uuid": "^11.1.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "esbuild": "^0.28.1",
    "next": "^16.3.8",
    "fast-xml-parser": "5.5.8",
    "protobufjs": "7.6.6",
    "@grpc/proto-loader": "^0.8.1"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "csv-parse": "^7.0.2",
      "ajv": "^8.18.0",
      "uuid": "^11.1.1",
      "postcss": "^8.5.23",
      "sharp": "^0.35.4",
      "esbuild": "^0.28.1",
      "next": "^16.3.8",
      "fast-xml-parser": "5.5.8",
      "protobufjs": "7.6.6",
      "@grpc/proto-loader": "^0.8.1"
    }
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=9"
  }
}